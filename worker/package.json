{
  "name": "reply-deck-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create:local": "wrangler d1 create meta-carousel-db --local",
    "db:migrate:local": "wrangler d1 migrations apply meta-carousel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meta-carousel-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
